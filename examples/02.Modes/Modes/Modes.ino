// @demo Sine -> envelope follower (decay 10 periods): follows the peaks
void Envelope_envelope() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  mimic.setEnvelopeFollower(1e7f / SIGNAL_HZ);
