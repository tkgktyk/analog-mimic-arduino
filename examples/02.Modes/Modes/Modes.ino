  // 10 x SIGNAL_HZ at Vref, 4 x SIGNAL_HZ per volt: the input +/-1.25 V sweeps +/-5 x SIGNAL_HZ
  mimic.setVco(SIGNAL_HZ * 10, SIGNAL_HZ * 4, 1.0f);
}

