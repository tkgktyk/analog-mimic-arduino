// --- Pwm ---

// @demo Sine -> PWM at 20 x signal: the duty cycle follows the input
void Pwm_pwm() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  // Full scale 1.25 V: 0 % at the bottom of the input, 100 % at the top
  mimic.setPwmModulator(SIGNAL_HZ * 20, 1.25f);
}

// --- VfConverter ---

// @demo Slow triangle -> V/F: a square wave from 0 to 20 x signal
void VfConverter_vf() {
  testSignal.begin(MimicTestSignal::TRIANGLE, SIGNAL_HZ / 10);
  // 10 x SIGNAL_HZ at Vref, 8 x SIGNAL_HZ per volt: 0 Hz (HIGH) at the bottom of the input
  mimic.setVfConverter(SIGNAL_HZ * 8, SIGNAL_HZ * 10);
}

// --- Logarithm ---

// @demo Triangle -> log amplifier (Vref 1.0 V, 1 V/decade): the ramps bend
void Logarithm_logAmp() {
  testSignal.begin(MimicTestSignal::TRIANGLE, SIGNAL_HZ);
  // The input (1.25 - 3.75 V) must stay above Vref: 0.25 - 2.75 V above 1.0 V gives 0.7 - 1.74 V
  mimic.setVref(1.0f);
  mimic.setLog(1.0f, 0.5f);
}

// @demo Triangle -> antilog amplifier (1 V/oct): the output doubles per volt
void Logarithm_antilogAmp() {
  testSignal.begin(MimicTestSignal::TRIANGLE, SIGNAL_HZ);
  // 1 / log10(2) V per decade; 0.5 V at Vref, 0.21 - 1.19 V for the input (from 0 V)
  mimic.setAntilog(1.0f / log10f(2.0f), 0.5f);
}

// --- Multiplier ---

// @demo Sine -> squarer: twice the frequency, from 0 V
void Multiplier_squarer() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  // (in - Vref)^2 / unit, unit VDD / 4 = 1.25 V: 0 - 1.25 V
  mimic.setSquarer();
}

// @demo Triangle -> square rooter: 0 below Vref, a square-root curve above
void Multiplier_squareRooter() {
  testSignal.begin(MimicTestSignal::TRIANGLE, SIGNAL_HZ);
  // sqrt((in - Vref) x 1.25 V): 0 - 1.25 V
  mimic.setSquareRooter();
}

// --- TrueRms ---

// @demo Sine -> true RMS: about 0.88 V DC (1.25 V / sqrt 2)
void TrueRms_rmsSine() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  // Averaging time constant: 10 periods of the signal, in us
  mimic.setTrueRms(1e7f / SIGNAL_HZ);
}

// @demo Square -> true RMS: 1.25 V DC (an average-responding meter reads 11 % more)
void TrueRms_rmsSquare() {
  testSignal.begin(MimicTestSignal::SQUARE, SIGNAL_HZ);
  mimic.setTrueRms(1e7f / SIGNAL_HZ);
}

