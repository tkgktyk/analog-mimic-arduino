// --- Rectifier ---

// @demo Sine -> full-wave rectifier: the negative half folds up (double frequency)
void Rectifier_fullWave() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  mimic.setRectifierFull();
}

// @demo Sine -> half-wave rectifier: the negative half stays at Vref
void Rectifier_halfWave() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  mimic.setRectifierHalf();
}

// --- Envelope ---

// @demo Sine -> envelope follower (decay 10 periods): follows the peaks
void Envelope_envelope() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  mimic.setEnvelopeFollower(1e7f / SIGNAL_HZ);
}

// @demo Sine -> peak hold: keeps the highest peak
void Envelope_peakHold() {
  testSignal.begin(MimicTestSignal::SINE, SIGNAL_HZ);
  mimic.setPeakHold();
}

// --- Integrator ---

// @demo Square -> integrator with leak: a triangle wave
void Integrator_integrator() {
  testSignal.begin(MimicTestSignal::SQUARE, SIGNAL_HZ);
  // 1.25 V for half a period ramps the output by about 2 V; the leak (10 periods) stops the drift
  mimic.setIntegrator(3e5f / SIGNAL_HZ, 1e7f / SIGNAL_HZ);
}

// --- Differentiator ---

// @demo Triangle -> differentiator: a square wave
void Differentiator_differentiator() {
  testSignal.begin(MimicTestSignal::TRIANGLE, SIGNAL_HZ);
  // The triangle slope (2.5 V per half period) gives about +-1 V. The limit time sets the
  // gain at high frequencies (differentiation time / limit time = 10 here): a shorter limit
  // gives sharper edges but amplifies the input noise as much
  mimic.setDifferentiator(2e5f / SIGNAL_HZ, 2e4f / SIGNAL_HZ);
}

