const int NUM_DEMOS = sizeof(DEMOS) / sizeof(DEMOS[0]);
const char KEYS[] = "0123456789abcdefghijklmnopqrs";

void printMenu() {
  Serial.println("\n=== Analog Mimic: Modes ===");
  for (int i = 0; i < NUM_DEMOS; i++) {
    Serial.print(KEYS[i]);
    Serial.print("  ");
    Serial.print(DEMOS[i].example);
    Serial.print(": ");
    Serial.println(DEMOS[i].text);
  }
}

void runDemo(int i) {
  Serial.print("\n[");
  Serial.print(KEYS[i]);
  Serial.print("] ");
  Serial.print(DEMOS[i].example);
  Serial.print(": ");
  Serial.println(DEMOS[i].text);
  mimic.setVref(mimic.getVdd() / 2);  // the default, in case a demo changed it
  DEMOS[i].run();
}

void setup() {
  Serial.begin(115200);
  Wire.begin();
  delay(2000);  // time to open the serial monitor
  if (!mimic.begin(&Wire)) {
    Serial.println("Analog Mimic not found");
    while (1);
  }
  printMenu();
  runDemo(0);
}

void loop() {
  if (Serial.available() <= 0) return;
  char c = Serial.read();
  if (c == '?') {
    printMenu();
    return;
  }
  if (c >= 'A' && c <= 'Z') c = c - 'A' + 'a';
  for (int i = 0; i < NUM_DEMOS; i++) {
    if (KEYS[i] == c) {
      runDemo(i);
      return;
    }
  }
}
